static func set_language(code: String) -> void:
	language = "fa" if code == "fa" else "en"


static func is_fa() -> bool:
	return language == "fa"


static func t(key: String) -> String:
	var table: Dictionary = FA if is_fa() else EN
	return str(table.get(key, EN.get(key, key)))


static func station_name(id: String) -> String:
	var key: String = "station_" + id
	var value: String = t(key)
	return value if value != key else id.capitalize()


static func product_name(id: String) -> String:
	var key: String = "product_" + id
	var value: String = t(key)
	return value if value != key else id.capitalize()
